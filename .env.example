# ── 赛博吃瓜鉴定局 1995 · 服务端环境变量 ─────────────────────────
# 复制本文件为 .env 后填写。没有 API Key 时，网站会自动使用「本地演示模式」，
# 所有核心功能仍然可以完整运行。

# AI 接口地址（兼容 OpenAI Chat Completions 协议）
AI_BASE_URL=https://api.openai.com/v1
# 密钥只保存在服务端，绝不会出现在浏览器代码里
AI_API_KEY=
# 模型名称（示例：gpt-4o-mini / deepseek-chat / qwen-plus）
AI_MODEL=gpt-4o-mini

# 服务端口（开发时 Vite 会把 /api 代理到这里）
PORT=8787

# 可选：请求超时（毫秒）
AI_TIMEOUT_MS=25000
